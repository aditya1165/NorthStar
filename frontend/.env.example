# Optional local Vite development overrides. Defaults work without this file.
# Used only by Vite's server-side proxy, not exposed in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:8000

# Leave blank for same-origin requests through Vite/Nginx.
# Explicit external endpoints require appropriate backend CORS configuration.
# VITE_* values are public build-time configuration, not secrets.
VITE_API_URL=
VITE_CONGESTION_WS_URL=
