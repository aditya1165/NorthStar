# Optional Docker Compose settings. Copy to .env in the repository root.
# The default binds only to this computer. Change to 0.0.0.0 deliberately for LAN access.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

# Public frontend BUILD-TIME settings. Leave blank for the bundled same-origin
# Nginx/API/WebSocket proxy. Rebuild the frontend after changing these.
# Never put secrets here: VITE_* values are embedded in JavaScript.
VITE_API_URL=
VITE_CONGESTION_WS_URL=

